# Per-deployment monitoring config. Copy this to monitoring/.env and fill
# in real values for THIS server, then use the start scripts
# (start-grafana.ps1/.sh, start-prometheus.ps1/.sh) instead of invoking
# grafana-server/prometheus directly.

# Path to the extracted binaries on this server. Recommended: extract
# Prometheus into bin/prometheus/ (gitignored, same as the daemon's own
# build output) so it's self-contained with the project; Grafana defaults
# to PATH since it's commonly installed system-wide (e.g. as a service).
PROMETHEUS_BIN=bin/prometheus/prometheus.exe
# Grafana >= 10 renamed the binary to grafana.exe (invoked as
# "grafana.exe server"); older installs still use grafana-server.exe
# directly. Point this at whichever your extracted/installed version uses -
# the start scripts append "server" only when GRAFANA_BIN ends in
# "grafana"/"grafana.exe".
GRAFANA_BIN=grafana

# Where the daemon's /metrics endpoint is reachable from wherever
# Prometheus runs (host:port, no scheme). Must match METRICS_PORT in the
# project's own .env if Prometheus and the daemon are on the same host.
METRICS_TARGET=localhost:9308

# Absolute path to monitoring/grafana/dashboards on this server.
GRAFANA_DASHBOARDS_PATH=

# Absolute path to monitoring/grafana/provisioning on this server.
GRAFANA_PROVISIONING_PATH=

# Where Grafana reaches Prometheus (usually the same host as Grafana).
PROMETHEUS_URL=http://localhost:9090

# Port Grafana listens on. Change if the default (3000) is already in use
# (e.g. by a frontend dev server).
GRAFANA_PORT=3000

# Path to the extracted Loki binary on this server. Recommended: extract
# into bin/loki/ (gitignored), same as Prometheus.
LOKI_BIN=bin/loki/loki.exe

# Ports Loki listens on (HTTP for push/query, gRPC internally).
LOKI_PORT=3100
LOKI_GRPC_PORT=9096

# Where Grafana reaches Loki (usually the same host as Grafana/Loki).
LOKI_URL=http://localhost:3100
